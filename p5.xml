<?xml version="1.0"?>
<?xml-stylesheet type="text/css" href="lang.css"?>

<courses>

    <title>Welcome to LearnHub!</title>
    <subtitle>Your gateway to mastering technology</subtitle>

    <course>
        <name>Programming</name>
        <description>Build strong programming foundations</description>
        <topics>Python | JavaScript | Java</topics>
    </course>

    <course>
        <name>Data Science</name>
        <description>Analyze and interpret complex data.</description>
        <topics>Machine Learning | Data Visualization | Deep Learning</topics>
    </course>

    <course>
        <name>Web Development</name>
        <description>Create modern and responsive websites.</description>
        <topics>HTML | CSS | React</topics>
    </course>

</courses>
courses {
    display: block;
    text-align: center;
    font-family: Arial;
}

title {
    display: block;
    font-size: 25px;
    color: darkblue;
    margin: 20px;
}

subtitle {
    display: block;
    color: gray;
}

course {
    display: inline-block;
    width: 250px;
    height: 200px;
    margin: 10px;
    padding: 15px;
    border: 1px solid silver;
    background-color: whitesmoke;
}

name {
    display: block;
    font-size: 20px;
    color: darkblue;
    margin: 10px;
}

description, topics {
    display: block;
    margin: 10px;
}
